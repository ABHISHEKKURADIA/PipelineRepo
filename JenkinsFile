/* groovy-lint-disable CompileStatic, NestedBlockDepth */

boolean fileCheck(String fname) {
    if (fileExists(fname)) {
        echo "Sucess ${fname} found!"
        return true
    }
    else
    {
        echo "${fname} not found"
        return false
    }
}

pipeline {
    agent any
    stages {
        stage('Initialize') {
                steps {
                script
                    {
                        if (fileCheck('index.htm')) {
                            echo 'File Found will continue'
                        }
                        else
                        {
                            error 'Critical file index.htm missing'
                        }
                    }
                }
        }
        stage('Test') {
            steps {
                script
                {
                    if (fileCheck('app.js')) {
                        echo 'App.js File Found will continue'
                    }
                    else
                    {
                        error 'Critical file app.js missing'
                    }
                }
            }
        }
        stage('Build') {
            steps {
                echo "Build Success, current Build number is ${currentBuild.number}"
            }
        }
    }
}
