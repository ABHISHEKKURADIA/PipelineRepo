pipeline {
    agent any

    stages {
        stage('Initialize') {
                steps {
                echo 'Hello World'
                }
            }
        
        stage('Test') {
            steps{
            echo 'Tested'
            }
        }
        
        stage('Build') {
            steps{
            echo "Build Sucess, current Build number is ${currentBuild.number}"
            }
            post {
                success{
                    script{
                        currentBuild.result='FAILURE'
                    }
                }
            }
        }
    }
    post{
        always{
            echo currentBuild.currentResult
        }
    }
}
