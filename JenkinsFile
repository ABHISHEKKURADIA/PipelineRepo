/* groovy-lint-disable CompileStatic */

void fileCheck(String fname) {
    if (fileExists(fname)) {
        echo "Sucess ${fname} found!"
    }
    else
    {
        error "${fname} not found"
    }
}

pipeline {
    agent any
    stages {
        stage('Initialize') {
                steps {
                script
                    {
                        fileCheck('index.htm')
                    }
                }
        }
        stage('Test') {
            steps {
                script
                {
                    fileCheck('app.js')
                }
            }
        }
        stage('Build') {
            steps {
                echo "Build Success, current Build number is ${currentBuild.number}"
            }
        }
    }
}
