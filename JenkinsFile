/* groovy-lint-disable CompileStatic */

void fileCheck(String fname) {
    if (fileExists(fname)) {
        echo 'Hello World'
    }
    else
    {
        error fname & 'not found'
    }
}

pipeline {
    agent any
    stages {
        stage('Initialize') {
                steps {
                script
                    {
                        fileCheck('index.htm')
                    }
                }
        }
        stage('Test') {
            steps {
                echo 'Tested'
            }
        }
        stage('Build') {
            steps {
                echo "Build Sucess, current Build number is ${currentBuild.number}"
            }
        }
    }
}
